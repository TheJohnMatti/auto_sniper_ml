# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Data & Output (Never commit raw scraped data)
data/raw/
data/processed/
data/clusters/
*.csv
*.json
*.parquet
*.sqlite3

# ...except the curated cluster labels (produced by the `label-clusters` skill,
# expensive to regenerate, redone only when clustering changes materially).
!data/clusters/
data/clusters/*
!data/clusters/label_map.json

# Python Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Run logs
logs/

# IDEs
.idea/
.vscode/
*.swp
*.swo